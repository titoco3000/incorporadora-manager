# Local development only (`make run`). In AWS the API uses DSQL (IAM auth) and SSM.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/incorporadora
JWT_SECRET=local-dev-secret

# Railway production database, read-only source for `make copy-local` / `make copy-aws`.
# Via `make railway-tunnel`: postgres://postgres:<PGPASSWORD>@localhost:15432/railway
RAILWAY_DATABASE_URL=
