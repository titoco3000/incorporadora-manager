          "attributes": {
            "arn": "arn:aws:cloudfront::891377185971:function/incorporadora-spa-prod",
            "code": "// Viewer-request function (cloudfront-js-2.0), default (S3) behavior only, never /api/*.\n// SvelteKit SPA: any path without a file extension is a client-side route → /index.html.\n// Files (/_app/..., /robots.txt, /favicon.png) pass through unchanged.\nfunction handler(event) {\n  var req = event.request;\n  var last = req.uri.split('/').pop();\n  if (last.indexOf('.') === -1) {\n    req.uri = '/index.html';\n  }\n  return req;\n}\n",
